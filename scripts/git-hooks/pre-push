#!/usr/bin/env bash
set -euo pipefail

case "${2:-}" in
  git@github.com:beiritdigital/angefangenes-portfolio.git|https://github.com/beiritdigital/angefangenes-portfolio.git)
    ;;
  *)
    echo "Push blocked: this portfolio may only be pushed to beiritdigital/angefangenes-portfolio." >&2
    exit 1
    ;;
esac

python3 "$(git rev-parse --show-toplevel)/scripts/check_portfolio_data.py"
git lfs pre-push "$@"
