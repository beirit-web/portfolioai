#!/usr/bin/env bash
set -euo pipefail

case "${2:-}" in
  git@github.com:beirit-web/angefangenes-portfolio.git)
    ;;
  *)
    echo "Push blocked: this portfolio may only be pushed to git@github.com:beirit-web/angefangenes-portfolio.git." >&2
    exit 1
    ;;
esac

python3 "$(git rev-parse --show-toplevel)/scripts/check_portfolio_data.py"
git lfs pre-push "$@"
