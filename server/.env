# --------------------------------------------------------------------------- #
# Django (local/dev defaults)
# --------------------------------------------------------------------------- #
# Public sample: do not put real credentials in this file or .env.
SECRET_KEY=fake-django-secret-for-portfolio-only
DEBUG=True
SITE_URL=http://localhost:8000
# Öffentliches Demo-Beispiel: portfolio.example.com
ALLOWED_HOSTS=localhost,127.0.0.1,portfolio.example.com
# Öffentliches Demo-Beispiel: https://portfolio.example.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://localhost:8000
REDIRECT_OLD_HOSTS=
CALENDAR_ENABLED=true
EVENTS_JSON_URL=/api/events/

# --------------------------------------------------------------------------- #
# Admin Security
# - In PROD eigene, nicht erratbare Slugs setzen (endet mit /).
# --------------------------------------------------------------------------- #
ADMIN_URL=admin-local/
ADMIN_NAME=admin
ADMIN_PASSWORD=
# ADMIN_IP_WHITELIST=127.0.0.1

# --------------------------------------------------------------------------- #
# Auth & Passwort-Reset (alle Pfade mit abschließendem /)
# --------------------------------------------------------------------------- #
AUTH_URL_PREFIX=auth/
PASSWORD_RESET_INVALID_URL=auth/reset/
PASSWORD_RESET_URL=password-reset/
PASSWORD_RESET_DONE_URL=password-reset/done/
PASSWORD_RESET_CONFIRM_PREFIX=reset/
PASSWORD_RESET_COMPLETE_URL=reset/done/
PASSWORD_RESET_DOMAIN=localhost:8000
PASSWORD_RESET_USE_HTTPS=False

# --------------------------------------------------------------------------- #
# Mail (Portfolio: Konsole; SMTP bleibt im Demo-Code deaktiviert)
# --------------------------------------------------------------------------- #
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=demo@example.com
EMAIL_HOST_PASSWORD=fake-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_SSL_CA_FILE=
EMAIL_SSL_SKIP_VERIFY=False
DEFAULT_FROM_EMAIL=noreply@example.com
CONTACT_EMAIL=kontakt@example.invalid
CONTACT_PHONE_SIGNAL=
CONTACT_PHONE_LANDLINE=
CONTACT_REGION=Musterstadt
CONTACT_AVAILABILITY=Antwort in < 24 Stunden
PRIVACY_CONSENT_VERSION=2026-06-22
SITE_OWNER_NAME=Max Mustermann
SITE_BUSINESS_NAME=Muster Portfolio
SITE_LEGAL_FORM=
SITE_ADDRESS=Musterstraße 1
SITE_STREET=
SITE_POSTAL_CODE=12345
SITE_CITY=Musterstadt
SITE_COUNTRY=Deutschland
SITE_EMAIL=demo@example.com
SITE_PHONE=
SITE_ACTIVITY=Web- und Softwareentwicklung; Übersetzung von Web- und Softwaretexten
SITE_TAX_NOTICE=Portfolio-Demo mit fiktiven Geschäftsdaten.
SITE_TAX_ID=
SITE_RESPONSIBLE_PERSON=
SITE_REGISTER_AUTHORITY=
SITE_REGISTER_DATE=
SITE_BUSINESS_START_DATE=
SITE_REGISTER_NAME=
SITE_REGISTER_NUMBER=
SITE_VAT_ID=
SITE_ECONOMIC_ID=
SITE_SUPERVISORY_AUTHORITY=
SITE_DISPUTE_RESOLUTION_NOTICE=Wir sind weder verpflichtet noch bereit, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.
UPLOAD_EMAIL_TO=${EMAIL_HOST_USER}
PROFILE_IMAGE_URL=

# --------------------------------------------------------------------------- #
# Upload-Restriktionen
# --------------------------------------------------------------------------- #
USER_UPLOADS_ENABLED=False
UPLOAD_MAX_BYTES=26214400
DATA_UPLOAD_MAX_MEMORY_SIZE=27262976
UPLOAD_ALLOWED_TYPES=application/pdf,image/png,image/jpeg
UPLOAD_SERVICE_START_HOUR=9
UPLOAD_SERVICE_END_HOUR=18
UPLOAD_SERVICE_BLOCK_WEEKENDS=True

# --------------------------------------------------------------------------- #
# Feature-Toggles
# --------------------------------------------------------------------------- #
LOGIN_REQUIRED=False
MAINTENANCE_MODE=False

# --------------------------------------------------------------------------- #
# Sicherheit (lokale Portfolio-Demo)
# --------------------------------------------------------------------------- #
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# --------------------------------------------------------------------------- #
# DB
# --------------------------------------------------------------------------- #
BACKUP_PASSPHRASE="fake-backup-passphrase"
DB_PATH=db.sqlite3
DB_BACKUP_PATH=./db_backups/


# --------------------------------------------------------------------------- #
# Payments: Portfolio-Demo; der Code deaktiviert Zahlungen unabhängig von .env.
# Sandbox-Zugangsdaten ausschließlich in einer isolierten Testkonfiguration.
# --------------------------------------------------------------------------- #
PAYMENT_BANK_TRANSFER_ENABLED=False
PAYPAL_INVOICE_CHECKOUT_ENABLED=False
PAYPAL_BUSINESS_EMAIL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=EUR
PAYPAL_DONATE_URL=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --------------------------------------------------------------------------- #
# Messengers
# --------------------------------------------------------------------------- #
CHAT_CONTACTS_JSON=[{"label":"Muster-Messenger","url":"https://messenger.example.invalid/demo-kontakt","hint":"Fiktiver Kontakt"}]
