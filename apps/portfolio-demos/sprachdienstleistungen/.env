# Lokale Portfolio-Demo; alle Identitäts- und Geschäftsdaten sind fiktiv.
SECRET_KEY=fake-django-secret-for-portfolio-only
DEBUG=True
NODE_ENV=development
SITE_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1,sprachservice.example.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000
ADMIN_URL=admin-demo/
ADMIN_NAME=demo-admin
ADMIN_PASSWORD=
ADMIN_EMAIL=demo@example.com
ADMIN_IP_WHITELIST=127.0.0.1
AUTH_URL_PREFIX=auth/
PASSWORD_RESET_INVALID_URL=auth/reset/
PASSWORD_RESET_URL=password-reset/
PASSWORD_RESET_DONE_URL=password-reset/done/
PASSWORD_RESET_CONFIRM_PREFIX=reset/
PASSWORD_RESET_COMPLETE_URL=reset/done/
PASSWORD_RESET_DOMAIN=localhost:8000
PASSWORD_RESET_USE_HTTPS=False
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
CONTACT_EMAIL=kontakt@example.com
CONTACT_REGION=Musterstadt
DB_PATH=./data/db.sqlite3
DB_BACKUP_PATH=./data/db_backups
UPLOAD_EMAIL_TO=demo@example.com
PAYPAL_BUSINESS_EMAIL=
PAYPAL_DONATE_URL=
CODEX_DB_EXPORT_ENABLED=False
CODEX_DB_EXPORT_TOKEN=
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
