DJANGO_ENV=local
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-real-secret-outside-git
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=secure-admin/
AUTH_TOKEN_MAX_AGE=7200
SESSION_SECURITY_ENABLED=true
SESSION_SECURITY_IDLE_TIMEOUT_SECONDS=7200
DATABASE_URL=sqlite:///db.sqlite3
DATABASE_CONN_MAX_AGE=0
DATABASE_SSL_REQUIRE=false
DATABASE_BACKUP_STRATEGY=
DATABASE_BACKUP_RETENTION_DAYS=0
WHITENOISE_ROOT=frontend_dist
DJANGO_DEV_ORIGINS=http://YOUR-LAN-IP:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
# Production examples:
# DJANGO_ENV=production
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=generate-a-long-random-secret
# DJANGO_ALLOWED_HOSTS=your-domain.example.com
# DATABASE_URL=postgresql://deutschlive:CHANGE_ME@localhost:5432/deutschlive
# DATABASE_CONN_MAX_AGE=600
# DATABASE_SSL_REQUIRE=true
# DATABASE_BACKUP_STRATEGY=managed-postgres-snapshot
# DATABASE_BACKUP_RETENTION_DAYS=14
# REDIS_URL=rediss://default:CHANGE_ME@redis.example.com:6379/0
# USE_REDIS_CACHE=true
# USE_REDIS_CHANNEL_LAYER=true
# DJANGO_CORS_ALLOWED_ORIGINS=https://your-domain.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example.com
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_SECURE_HSTS_PRELOAD=false
# DJANGO_USE_X_FORWARDED_PROTO=true

# Portfolio-Demo: Zahlungen und Webhooks bleiben im Code deaktiviert.
# Für isolierte Tests werden nur Stripe-Testdaten und die PayPal-Sandbox genutzt.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_API_BASE=https://api.stripe.com/v1
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_PREMIUM_MONTHLY=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
BILLING_SUCCESS_URL=http://localhost:5173/dashboard
BILLING_CANCEL_URL=http://localhost:5173/dashboard

# Public app URL and transactional mail
DEUTSCHLIVE_PUBLIC_URL=http://localhost:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=noreply@example.com
CONTACT_EMAIL=kontakt@example.com

# Security controls
SECURE_UPLOAD_MAX_SIZE_MB=5
SECURE_UPLOAD_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,application/pdf
UPLOAD_VALIDATION_ENABLED=true
UPLOAD_VALIDATION_PATH_PREFIXES=/api/
DJANGO_SECURE_REFERRER_POLICY=same-origin
DJANGO_CONTENT_SECURITY_POLICY=
DJANGO_CONTENT_SECURITY_POLICY_REPORT_ONLY=true
DJANGO_PERMISSIONS_POLICY=accelerometer=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
DJANGO_CROSS_ORIGIN_OPENER_POLICY=same-origin
RATE_LIMITING_ENABLED=true
RATE_LIMIT_LOGIN_LIMIT=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_FEEDBACK_LIMIT=3
RATE_LIMIT_FEEDBACK_WINDOW_SECONDS=600
RATE_LIMIT_QUIZ_ATTEMPT_LIMIT=30
RATE_LIMIT_QUIZ_ATTEMPT_WINDOW_SECONDS=600
RATE_LIMIT_API_WRITE_LIMIT=120
RATE_LIMIT_API_WRITE_WINDOW_SECONDS=60

# Logging and monitoring
MONITORING_PROVIDER=logs
SENTRY_DSN=
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=WARNING
SECURITY_LOG_LEVEL=WARNING
REQUEST_LOG_LEVEL=INFO
REQUEST_LOGGING_ENABLED=true
API_ERROR_LOGGING_ENABLED=true
API_ERROR_INCLUDE_DEBUG=false
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=DeutschLive is temporarily in maintenance mode.
MAINTENANCE_RETRY_AFTER_SECONDS=300
MAINTENANCE_BLOCK_FRONTEND=false

# AI / GPT placeholders - fallback logic works without a key
AI_PROVIDER=fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_OUTPUT_TOKENS=800
OPENAI_MAX_RETRIES=2
AI_FEATURES_ENABLED=false
AI_STREAMING_PREPARED=true
AI_STREAMING_CORRECTIONS_ENABLED=false
AI_MAX_INPUT_TOKENS=700
AI_DAILY_FREE_LIMIT=10
AI_DAILY_PREMIUM_LIMIT=100
AI_PREMIUM_REQUIRED=false
PREMIUM_ACCESS_ENABLED=true

# Realtime / WebSockets
REDIS_URL=redis://127.0.0.1:6379/0
USE_REDIS_CACHE=false
USE_REDIS_CHANNEL_LAYER=false
REALTIME_NOTIFICATIONS_ENABLED=true
REALTIME_MESSENGER_PREPARED=true
REALTIME_LEARNING_ROOMS_PREPARED=true
REALTIME_WS_ACCESS_ENABLED=true
REALTIME_WS_CONNECTION_LIMIT=30
REALTIME_WS_CONNECTION_WINDOW_SECONDS=60
