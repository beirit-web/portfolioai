# Send only the source directories needed by the image build.
**
!Dockerfile
!.dockerignore
!frontend/
!frontend/**
!apps/
!apps/deutsch-live/
!apps/deutsch-live/**
!apps/wohnungssuche/
!apps/wohnungssuche/**
!server/
!server/**
!scripts/
!scripts/container-entrypoint.py
!scripts/container_settings.py

# Overrides and runtime state must never reach the build service.
**/.env
**/.env.*
!**/.env.example
**/.git
**/.github
**/.codex
**/.agents
**/.aws
**/.ssh
**/.fly
**/.npmrc
**/.pypirc
**/node_modules
**/.venv
**/venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.DS_Store
**/*~
**/*.log
**/*.sqlite
**/*.sqlite3
**/*.sqlite3-*
**/*.sqlite-*
**/*.db
**/*.db-*
**/*.sql
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.bundle
**/*.bak
**/*.backup
**/*.zip
**/*.tar
**/*.gz
**/*.tgz
**/*.7z
**/secrets
**/private
**/client-data
**/backups
**/db_backups
**/test-results
**/playwright-report
server/data
server/media
server/staticfiles
server/assets/portfolio-dist
server/assets/deutschlive-dist
server/assets/portfolio/wohnungssuche
